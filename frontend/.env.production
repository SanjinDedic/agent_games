VITE_AGENT_API_URL = https://api.agentgames.io

# REQUIRED before deploy: direct browser→Lambda exercise/snippet fallback
# (src/utils/lambdaFallback.js) is the ONLY fallback path — the API never
# executes exercise/snippet code. Set to the Function URL printed by
# backend/fallback_lambda/deploy.sh. Unset means students have no fallback
# and VITE_PYODIDE_EXERCISES=false builds cannot run code at all.
VITE_EXERCISE_LAMBDA_URL = https://cx7lxktle3ux5db23wo345gfgy0xajrj.lambda-url.ap-southeast-2.on.aws/

# REQUIRED before deploy: direct browser→Lambda agent-validation fallback,
# same mechanics as the exercise one. Set to the Function URL printed by
